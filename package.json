{
  "name": "overvibe",
  "version": "1.0.0",
  "description": "Claude Code, Codex and agy side by side on your Mac or Linux machine, and a CLI that lets them start and message each other.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://overvibe.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maribol/overvibe.git"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "overvibe": "bin/overvibe"
  },
  "files": [
    "bin/overvibe",
    "install.sh",
    "scripts/install-cli.sh",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.45"
  },
  "scripts": {
    "start": "bun run build && bun server.ts",
    "build": "vite build",
    "dev": "trap 'kill 0' EXIT; vite build --watch & bun --watch server.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p src/web/tsconfig.json",
    "desktop": "cd desktop && bun install && bun run start",
    "desktop:build": "cd desktop && bun install && bun run build",
    "install-cli": "bash scripts/install-cli.sh",
    "smoke": "bun scripts/smoke.ts"
  }
}
